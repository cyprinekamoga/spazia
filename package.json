{
  "name": "spazia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_APP_URL=http://localhost:3001 next dev",
    "dev:app": "SPAZIA_TARGET=app next dev -p 3001",
    "build": "next build && node scripts/postbuild.mjs",
    "build:app": "SPAZIA_TARGET=app npm run build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/finlandica": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@netlify/blobs": "^10.7.13",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
