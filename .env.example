# Copy to .env.local for local development, and set the same keys as
# environment variables in Netlify (Project configuration > Environment variables).
# Everything is optional – the site works without them.

# --- Build-time (public) -------------------------------------------------
# Leads are stored in Supabase when both are set; otherwise Netlify Forms is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Meta Pixel (default 2604701499980220 is set in src/lib/site.ts). Loads only after cookie consent.
NEXT_PUBLIC_META_PIXEL_ID=
# Cookie-free statistics. Set to spazia.se once the site is added at plausible.io.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Search Console, "HTML tag" method: only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Functions (server-side only, never exposed to the browser) ----------
# Emails on every registration (netlify/functions/lead-emails.mts), via any SMTP service.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@nordvra.se
SMTP_PASS=
MAIL_FROM="Spazia <info@nordvra.se>"
MAIL_TO=info@nordvra.se
# MAIL_CONFIRMATION=off   # stop confirmation emails to the person who registered
