# Copy to .env.local for local development, and set the same keys as
# environment variables in Netlify (Project configuration > Environment variables).
# All are optional – the site works without them.

# Supabase (leads are stored here when both are set; otherwise Netlify Forms is used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meta Pixel for the ad campaign (only loaded after cookie consent)
NEXT_PUBLIC_META_PIXEL_ID=
